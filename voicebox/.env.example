# Copy to .env in the voicebox folder. Everything is optional; defaults shown.
VOICEBOX_MODEL=qwen3.8:27b               # any Ollama chat model
# OLLAMA_HOST=http://127.0.0.1:11434
VOICEBOX_THINK=false                     # thinking mode slows the first words; leave off for voice
VOICEBOX_KEEP_ALIVE=30m                  # keep the model loaded this long after a question (Ollama keep_alive)
VOICEBOX_SPEECH_URL=http://127.0.0.1:8880/v1   # the speech server (rinn-voice-server) for STT and TTS
# VOICEBOX_SPEECH_API_KEY=
# VOICEBOX_SPEECH_TIMEOUT=120                # seconds to wait for one transcription or one sentence of speech
# VOICEBOX_TTS_MODEL=voicebox                # model name sent to the speech server (rinn-voice-server ignores it)
VOICEBOX_VOICE=af_heart                  # voice id known to the speech server (or "clone")
VOICEBOX_EMBED_MODEL=nomic-embed-text    # ollama pull nomic-embed-text ; blank = keyword-only search
VOICEBOX_KNOWLEDGE_DIR=knowledge
VOICEBOX_DATA_DIR=data
VOICEBOX_PERSONA_FILE=persona.md
VOICEBOX_TOP_K=4                         # notes passed to the model per question
VOICEBOX_MAX_HISTORY_TURNS=10
VOICEBOX_HOST=127.0.0.1                  # 0.0.0.0 to reach it from other devices (pair with an API key)
VOICEBOX_PORT=8800
# VOICEBOX_API_KEY=choose-a-long-password
