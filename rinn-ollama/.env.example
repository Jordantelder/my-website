# Copy to .env and adjust. Every variable is optional; defaults are shown.
OLLAMA_HOST=http://localhost:11434   # host:port or a bare host (port 11434 assumed) also work
RINN_MODEL=qwen3.8:27b
RINN_TEMPERATURE=0.4
RINN_TOP_P=0.9
RINN_NUM_CTX=32768
RINN_REPEAT_PENALTY=1.05
# RINN_NUM_PREDICT=-1          # -1 = unlimited, -2 = fill context
# RINN_SEED=42                 # fixed seed for reproducible answers
RINN_THINK=true                # Qwen3.8 thinking mode on/off
RINN_SHOW_THINKING=false       # print the model's reasoning while it streams
RINN_KEEP_ALIVE=10m            # how long Ollama keeps the model loaded
RINN_TIMEOUT=600               # seconds to wait for a response (connecting is capped at 10 s)
RINN_MAX_HISTORY_TURNS=20      # conversation turns kept in context
# RINN_EXTRA_INSTRUCTIONS=Focus on CDRH-regulated devices.
